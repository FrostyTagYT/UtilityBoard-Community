<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>disable</Nullable><ImplicitUsings>enable</ImplicitUsings><LangVersion>latest</LangVersion>
    <AssemblyName>UtilityBoardCompanion</AssemblyName><RootNamespace>BoardCompanion</RootNamespace><Version>2.0.0</Version><Product>Utility Board Companion</Product><Company>Utility Board Companion</Company><Authors>Utility Board Companion</Authors>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages><Deterministic>true</Deterministic><DebugType>none</DebugType>
    <PathMap>$(MSBuildProjectDirectory)=/src</PathMap><EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>COMMUNITY</DefineConstants><NoWarn>CS0162;CS8981</NoWarn>
  </PropertyGroup>
  <ItemGroup><Compile Include="../src/*.cs" /></ItemGroup>
  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="NAudio.Vorbis" Version="1.5.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
</Project>
